# Example systemd unit for probeme-mothership.
# Install to /etc/systemd/system/probeme-mothership.service, then:
#   systemctl daemon-reload && systemctl enable --now probeme-mothership

[Unit]
Description=probeme mothership exporter (node_* / DCGM_FI_DEV_* / pme_*)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prometheus
Group=prometheus
ExecStart=/usr/local/bin/probeme-mothership \
	--provider.dir=/usr/lib/probeme \
	--probe.interval=5s \
	--probe.timeout=3s \
	--web.listen-address=127.0.0.1:9167
Environment=PME_LOG_LEVEL=info

Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
